# Copia in `.env.local` per lo sviluppo; su Vercel imposta le stesse chiavi
# in Project Settings → Environment Variables.

# Connection string pooled di Neon (Neon Console → Connect → pooled).
# Es: postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/eurocollection?sslmode=require

# Segreto per firmare i cookie di sessione JWT (min 32 caratteri).
# Genera con: openssl rand -base64 32
AUTH_SECRET=cambia-questo-segreto-con-almeno-32-caratteri-casuali
